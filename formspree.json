{
  "forms": {
    "contactForm": {
      "name": "Ashen Software Contact",
      "fields": {
        "name": {
          "type": "text",
          "required": true,
          "minlength": 2,
          "maxlength": 100
        },
        "email": {
          "type": "email",
          "required": true,
          "minlength": 5,
          "maxlength": 254
        },
        "message": {
          "type": "text",
          "required": true,
          "minlength": 10,
          "maxlength": 5000
        },
        "company": {
          "type": "text",
          "required": false,
          "maxlength": 200
        },
        "service": {
          "type": "text",
          "required": false,
          "maxlength": 120
        },
        "phone": {
          "type": "text",
          "required": false,
          "maxlength": 40
        },
        "source": {
          "type": "text",
          "required": false,
          "maxlength": 200
        },
        "locale": {
          "type": "text",
          "required": false,
          "maxlength": 8
        }
      },
      "actions": [
        {
          "type": "email",
          "to": "$FORMSPREE_NOTIFICATION_EMAIL"
        }
      ]
    }
  }
}
